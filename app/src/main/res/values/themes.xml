<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.SmartAttendance" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorSecondaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnSecondary">@color/text_on_primary</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/canvas_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <!-- Window background -->
        <item name="android:windowBackground">@color/canvas_bg</item>
    </style>
</resources>
