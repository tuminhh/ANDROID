<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Mã lớp học phần *"
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/codeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_input_field"
            android:hint="Ví dụ: INT101, SQA401"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:maxLength="32"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Tên môn học *"
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/nameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_input_field"
            android:hint="Ví dụ: Đảm bảo chất lượng phần mềm"
            android:inputType="text"
            android:maxLength="200"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Thứ trong tuần *"
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerDayOfWeek"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_input_field"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Tiết học / Ca học *"
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <AutoCompleteTextView
            android:id="@+id/shiftInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_input_field"
            android:completionThreshold="1"
            android:hint="Ví dụ: Buổi sáng - Tiết 1,2,3"
            android:inputType="text"
            android:maxLength="100"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Phòng học *"
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/roomInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_input_field"
            android:hint="Ví dụ: 402 - A9 hoặc P101"
            android:inputType="text"
            android:maxLength="200"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Học kỳ (Tùy chọn)"
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp" />

        <EditText
            android:id="@+id/semesterInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_field"
            android:hint="Ví dụ: HK1 2026-2027"
            android:inputType="text"
            android:maxLength="50"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
